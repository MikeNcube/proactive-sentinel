DATABASE_URL=postgresql://user:password@host:5432/database
# Railway note: if provided as postgres://..., normalize to postgresql://
REDIS_URL=redis://host:6379/0
JWT_SECRET_KEY=replace-with-random-64-hex
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=604800
ENCRYPTION_KEY=replace-with-base64-32-byte-key
BACKUP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
DASHBOARD_SECRET_KEY=replace-with-random-64-hex
SECRET_KEY=replace-with-random-64-hex
FLASK_APP=app.py
PORT=8080
DB_STARTUP_TIMEOUT_SECONDS=20
DB_STARTUP_RETRY_INTERVAL_SECONDS=2
ALLOWED_ORIGINS=https://your-app.up.railway.app,http://localhost:5000,http://localhost:5001
API_BASE_URL=http://localhost:5001/api
HEALTH_URL=http://localhost:5001/health
MAX_REQUEST_BYTES=1048576
UNIT_ID_WHITELIST=unit-001,unit-002
CAPTCHA_SECRET_KEY=replace-with-captcha-secret
ZORORO_CLAIMS_URL=https://claims.example.com
AI_SOCIAL_AGENT_URL=https://social.example.com
PROACTIVE_SENTINEL_URL=https://proactive-sentinel.example.com
SENTINEL_URL=https://proactive-sentinel.example.com/dashboard

# Email alert notifications (leave SMTP_HOST blank to disable)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sentinel-alerts@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=sentinel-alerts@example.com
ALERT_EMAIL_RECIPIENTS=security@example.com,it@example.com

# Deployment environment
ENVIRONMENT=production
