# =============================================================================
# Proactive Sentinel - environment variable template
# =============================================================================
# This file is the ONLY committed source of truth for required env vars.
# Copy it to .env for local development and fill in real values:
#
#     cp .env.example .env
#
# NEVER commit the real .env. The .gitignore already excludes it.
#
# For production, set these values in your platform's secret store
# (Railway -> Variables, AWS Secrets Manager, Vault, Kubernetes Secret, etc.).
# Use scripts/rotate_secrets.py to generate fresh random values.
# =============================================================================

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
FLASK_APP=app.py
PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL (required)
#
# Railway sometimes provides postgres://... which SQLAlchemy rejects; the app
# normalises it to postgresql://. For local dev with docker-compose, the
# compose file builds the URL from POSTGRES_PASSWORD.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_STARTUP_TIMEOUT_SECONDS=20
DB_STARTUP_RETRY_INTERVAL_SECONDS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# POSTGRES_PASSWORD is only consumed by docker-compose.yml to build
# DATABASE_URL and to initialise the 'sentinel' role inside the container.
# Leave blank for production deployments that set DATABASE_URL directly.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE

# ---------------------------------------------------------------------------
# Redis (optional in dev; required in prod for distributed rate limiting)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Crypto / signing secrets
#
# Generate with: python scripts/rotate_secrets.py --preview
#
# - JWT_SECRET_KEY:        64 hex chars (32 random bytes). Used to sign JWTs.
# - ENCRYPTION_KEY:        base64-encoded 32 bytes. AES-256-GCM PII key.
# - BACKUP_ENCRYPTION_KEY: base64-encoded 32 bytes. Used for rotation windows.
# - DASHBOARD_SECRET_KEY:  64 hex chars. Flask session cookie signing key
#                           for dashboard/flask_dashboard.py.
# - CAPTCHA_SECRET_KEY:    provider-specific secret for bot protection.
#
# IMPORTANT: rotating ENCRYPTION_KEY without re-encrypting existing rows
# will make decryption fail. Only rotate during a planned maintenance
# window with a re-encryption step.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_64_HEX_CHARS
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
DASHBOARD_SECRET_KEY=CHANGE_ME_64_HEX_CHARS
CAPTCHA_SECRET_KEY=CHANGE_ME_CAPTCHA_PROVIDER_SECRET

# ---------------------------------------------------------------------------
# JWT lifetime (seconds)
# ---------------------------------------------------------------------------
JWT_ACCESS_EXPIRES=3600

# ---------------------------------------------------------------------------
# HTTP / CORS
# ---------------------------------------------------------------------------
# Explicit list of allowed origins; do not use wildcards on shared PaaS
# domains (e.g. *.railway.app) because any tenant of that PaaS becomes
# a trusted origin.
ALLOWED_ORIGINS=https://your-app.example.com,http://localhost:5000,http://localhost:5001
API_BASE_URL=http://localhost:5001/api
HEALTH_URL=http://localhost:5001/health
MAX_REQUEST_BYTES=1048576

# ---------------------------------------------------------------------------
# Optional runtime knobs
# ---------------------------------------------------------------------------
# Comma-separated allow-list of device_ids that may register as units.
UNIT_ID_WHITELIST=
# Comma-separated IPs pre-populated as known-bad in the ThreatDetector.
KNOWN_BAD_IPS=
